# ---------------------------------------------------------------------------
# worklog-api ortam değişkenleri
#
# Bu dosya YAPIYI gösterir, gerçek değer içermez ve repoya commit edilir.
# Kullanmak için kopyala:   cp .env.example .env
# Gerçek .env dosyası .gitignore içindedir, asla commit edilmez.
# ---------------------------------------------------------------------------

# Çalışma ortamı: development | test | production
NODE_ENV=development

# API'nin dinleyeceği port
PORT=3000

# MongoDB bağlantı adresi (Docker'sız, lokal çalıştırma için)
# Docker Compose ile çalışırken bu değer compose tarafından EZİLİR ve
# "mongodb://mongo:27017/worklog" olur — çünkü container içinde "localhost"
# container'ın kendisidir, Mongo değil. Mongo'ya servis adıyla erişilir.
MONGO_URI=mongodb://localhost:27017/worklog

# JWT imzalama anahtarı — EN AZ 32 KARAKTER olmalı.
# Üretmek için:  openssl rand -base64 48
# Buraya gerçek değeri YAZMA, sadece .env dosyana yaz.
JWT_SECRET=buraya-en-az-32-karakterlik-rastgele-bir-deger-gelecek

# Token geçerlilik süresi (örn. 15m, 1d, 7d)
JWT_EXPIRES_IN=1d

# Log seviyesi: fatal | error | warn | info | debug | trace | silent
# ("silent" testlerde log gürültüsünü kapatmak için kullanılır)
LOG_LEVEL=info
